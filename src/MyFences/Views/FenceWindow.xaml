<Window x:Class="MyFences.Views.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Title="MyFences"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="CanResize"
        MinWidth="140"
        MinHeight="30"
        AllowDrop="True"
        DragEnter="OnDragEnter"
        DragOver="OnDragOver"
        Drop="OnDrop"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave">

    <Window.Resources>
        <DropShadowEffect x:Key="TextShadow" ShadowDepth="1" BlurRadius="3" Opacity="0.9" Color="Black" />

        <Style x:Key="FenceItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="ToolTip" Value="{Binding FullPath}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#45FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="6"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            PreviewMouseRightButtonUp="OnRightButtonUp">
        <DockPanel>
            <Border x:Name="TitleBar"
                    DockPanel.Dock="Top"
                    Height="28"
                    CornerRadius="5,5,0,0"
                    MouseLeftButtonDown="OnTitleMouseLeftButtonDown">
                <TextBlock x:Name="TitleText"
                           Margin="10,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Effect="{StaticResource TextShadow}" />
            </Border>

            <!-- 分區內的分頁（有 2 個以上分頁才顯示） -->
            <WrapPanel x:Name="TabStrip" DockPanel.Dock="Top" Margin="6,4,6,0" Visibility="Collapsed" />

            <Grid>
                <ListBox x:Name="ItemsList"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="4"
                         SelectionMode="Single"
                         ItemContainerStyle="{StaticResource FenceItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseDoubleClick="OnItemsDoubleClick"
                         PreviewMouseLeftButtonDown="OnItemsPreviewMouseLeftButtonDown"
                         PreviewMouseRightButtonDown="OnItemsPreviewMouseRightButtonDown"
                         PreviewMouseMove="OnItemsPreviewMouseMove"
                         PreviewKeyDown="OnItemsPreviewKeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="{Binding CellWidth, RelativeSource={RelativeSource AncestorType=Window}}" Opacity="{Binding ItemOpacity}">
                                <Image Source="{Binding Icon}"
                                       Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding DisplayName}"
                                           Margin="0,4,0,0"
                                           MaxHeight="34"
                                           Foreground="White"
                                           FontSize="12"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           Effect="{StaticResource TextShadow}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyHint"
                           IsHitTestVisible="False"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#B0FFFFFF"
                           FontSize="12"
                           TextAlignment="Center"
                           Effect="{StaticResource TextShadow}" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
