<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 只用來做系統匣圖示（NotifyIcon） -->
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>MyFences</AssemblyName>
    <RootNamespace>MyFences</RootNamespace>
    <Version>0.3.0</Version>
    <!-- WPF 程式用 manifest 設定 DPI，不適用 WinForms 的 SetHighDpiMode 建議 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!--
    exe 的「內容 → 詳細資料」會顯示這些資訊。沒有任何版本 / 發行者資訊的 exe
    比較容易被防毒軟體的啟發式掃描當成可疑程式。
  -->
  <PropertyGroup>
    <Product>MyFences</Product>
    <AssemblyTitle>MyFences 桌面分區整理工具</AssemblyTitle>
    <Description>Desktop organizer that groups desktop icons into fences.</Description>
    <Company>lichin1</Company>
    <Authors>lichin1</Authors>
    <Copyright>Copyright © 2026 lichin1</Copyright>
    <NeutralLanguage>zh-TW</NeutralLanguage>
  </PropertyGroup>

</Project>
